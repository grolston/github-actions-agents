{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prerequisite-validator report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "verdict",
    "prerequisites",
    "findings",
    "summary_markdown"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "const": "prerequisite-validator"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "findings",
        "error"
      ]
    },
    "aws_account_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Account inspected (from sts get-caller-identity), or null without AWS access"
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "prerequisites": {
      "type": "array",
      "description": "One row per external reference found in the change.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "identifier",
          "referenced_in",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "ssm-parameter, secret, vpc, subnet, security-group, ami, kms-key, acm-certificate, hosted-zone, iam-role, s3-bucket, cfn-export, ..."
          },
          "identifier": {
            "type": "string",
            "description": "Name, ID, or ARN as written (resolved value if it came from a default)"
          },
          "referenced_in": {
            "type": "string",
            "description": "path:line"
          },
          "status": {
            "type": "string",
            "enum": [
              "exists",
              "missing",
              "mismatch",
              "not-checkable",
              "unable-to-verify"
            ]
          },
          "detail": {
            "type": "string",
            "description": "e.g. type String vs SecureString, wrong region, belongs to another VPC"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "resource",
          "description",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "suggestion"
            ]
          },
          "category": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "path:line in the repository, when applicable"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary_markdown": {
      "type": "string"
    }
  }
}
