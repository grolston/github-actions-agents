{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deployment-plan-analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "verdict",
    "intent_match",
    "environments",
    "findings",
    "summary_markdown"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "const": "deployment-plan-analysis"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "findings",
        "error"
      ]
    },
    "aws_account_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Account inspected (from sts get-caller-identity), or null without AWS access"
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "intent_match": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "none"
      ]
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "account_id",
          "region",
          "add",
          "modify",
          "replace",
          "delete",
          "est_monthly_cost_delta_usd"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "add": {
            "type": "integer"
          },
          "modify": {
            "type": "integer"
          },
          "replace": {
            "type": "integer"
          },
          "delete": {
            "type": "integer"
          },
          "est_monthly_cost_delta_usd": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "resource",
          "description",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "suggestion"
            ]
          },
          "category": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "path:line in the repository, when applicable"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary_markdown": {
      "type": "string"
    }
  }
}
