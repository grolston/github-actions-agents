{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow-security report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "verdict",
    "files_reviewed",
    "findings",
    "summary_markdown"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "const": "workflow-security"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "findings",
        "error"
      ]
    },
    "files_reviewed": {
      "type": "array",
      "description": "One row per workflow or action file the change touches.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "kind",
          "status"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "workflow",
              "composite-action",
              "reusable-workflow",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "issues"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "resource",
          "description",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "suggestion"
            ]
          },
          "category": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "description": "Function, class, job, step, or other named thing the finding is about"
          },
          "file": {
            "type": "string",
            "description": "path:line in the repository, when applicable"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary_markdown": {
      "type": "string"
    }
  }
}
