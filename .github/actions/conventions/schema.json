{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conventions report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "verdict",
    "conventions",
    "findings",
    "summary_markdown"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "const": "conventions"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "findings",
        "error"
      ]
    },
    "conventions": {
      "type": "array",
      "description": "One row per written rule that applies to the change.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "source",
          "status"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "description": "The rule, quoted or closely paraphrased"
          },
          "source": {
            "type": "string",
            "enum": [
              "repo-guidance",
              "org-rules"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "followed",
              "violated",
              "not-applicable"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "resource",
          "description",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "suggestion"
            ]
          },
          "category": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "description": "Function, class, job, step, or other named thing the finding is about"
          },
          "file": {
            "type": "string",
            "description": "path:line in the repository, when applicable"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary_markdown": {
      "type": "string"
    }
  }
}
