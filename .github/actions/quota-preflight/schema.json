{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quota-preflight report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "verdict",
    "quotas",
    "findings",
    "summary_markdown"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "const": "quota-preflight"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "findings",
        "error"
      ]
    },
    "aws_account_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Account inspected (from sts get-caller-identity), or null without AWS access"
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "quotas": {
      "type": "array",
      "description": "One row per quota the change consumes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_code",
          "quota_code",
          "quota_name",
          "scope",
          "current_usage",
          "applied_limit",
          "added_by_change",
          "projected_utilization_pct",
          "status"
        ],
        "properties": {
          "service_code": {
            "type": "string"
          },
          "quota_code": {
            "type": "string"
          },
          "quota_name": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "description": "account/region or per-resource scope, e.g. us-east-1 or per VPC"
          },
          "current_usage": {
            "type": [
              "number",
              "null"
            ]
          },
          "applied_limit": {
            "type": [
              "number",
              "null"
            ]
          },
          "added_by_change": {
            "type": [
              "number",
              "null"
            ]
          },
          "projected_utilization_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "usage_source": {
            "type": "string",
            "description": "AWS/Usage metric, describe-* count, account limit API, or unavailable"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "exceeded",
              "unknown"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "resource",
          "description",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "suggestion"
            ]
          },
          "category": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "path:line in the repository, when applicable"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary_markdown": {
      "type": "string"
    }
  }
}
